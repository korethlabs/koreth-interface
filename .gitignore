# Dependencies
node_modules/

# Next.js build output
.next/
out/
*.tsbuildinfo

# Auto-generated from koreth-v1-core (run `npm run prepare-frontend`)
src/generated/

# Env / secrets — NEVER commit keys or mnemonics
.env
.env.local
.env*.local

# Working notes — local research log, not shipped docs (same convention as koreth-v1-core)
docs/

# OS / IDE
.DS_Store
.idea/
.vscode/
*.swp

# Logs
*.log
npm-debug.log*

# Local agent harness config — not protocol source
# No trailing slash: inside a repo checkout these are symlinks to the workspace
# copy, and a "name/" pattern matches only a real directory, never a symlink.
.axa
AXA.md
.claude
CLAUDE.md
